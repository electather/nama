{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "apps/server/src/database/auth-schema.ts",
    "gen/ts/src/**",
    "tools/agent-issue/standard-schema-spec.d.ts"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true
  },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node"],
  "rules": {
    "curly": "error",
    "eqeqeq": "error",
    "eslint/capitalized-comments": [
      "error",
      "always",
      {
        "line": {
          "ignorePattern": "^fallow-ignore-(?:next-line|file)"
        }
      }
    ],
    "eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "eslint/sort-imports": "off",
    "import/no-cycle": "error",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "no-console": "error",
    "import/no-nodejs-modules": "off",
    "sort-keys": "warn",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/prefer-export-from": "off"
  },
  "overrides": [
    {
      "files": ["apps/server/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nama/jellyfin", "@nama/jellyfin/**", "**/plugins/jellyfin/**"],
                "message": "The core must call Jellyfin only through generated plugin contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/jellyfin/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nama/server", "@nama/server/**", "**/apps/server/**"],
                "message": "Jellyfin must call the core only through generated plugin contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/config/overlay.ts", "apps/server/src/config/schema.ts"],
      "rules": {
        "eslint/new-cap": [
          "error",
          {
            "capIsNewExceptions": ["Literals", "Record", "RedactedFromValue", "Struct"]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/setup/bootstrap-token.ts"],
      "rules": {
        "unicorn/no-useless-undefined": "off",
        "node/no-sync": "off"
      }
    },
    {
      "files": [
        "apps/server/src/config/config.ts",
        "apps/server/src/database/database.ts",
        "apps/server/src/http/listener.ts"
      ],
      "rules": {
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      "files": ["tools/agent-issue.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-lines": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-params": "off",
        "eslint/max-statements": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/prefer-destructuring": "off",
        "eslint/prefer-named-capture-group": "off",
        "eslint/require-unicode-regexp": "off",
        "eslint/sort-keys": "off",
        "import/max-dependencies": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/no-await-expression-member": "off",
        "unicorn/no-null": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/prefer-ternary": "off"
      }
    },
    {
      "files": ["tools/agent-issue/cli.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/no-continue": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/sort-keys": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["tools/agent-issue/command.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-params": "off",
        "eslint/max-statements": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-nested-ternary": "off",
        "eslint/no-ternary": "off",
        "eslint/sort-keys": "off",
        "import/exports-last": "off",
        "import/group-exports": "off",
        "promise/prefer-await-to-callbacks": "off",
        "unicorn/no-nested-ternary": "off"
      }
    },
    {
      "files": ["tools/agent-issue/completion-policy.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/sort-keys": "off",
        "typescript/array-type": "off",
        "unicorn/prefer-string-raw": "off"
      }
    },
    {
      "files": ["tools/agent-issue/github-snapshot.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/max-statements": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/prefer-named-capture-group": "off",
        "eslint/sort-keys": "off",
        "import/exports-last": "off",
        "import/group-exports": "off",
        "typescript/array-type": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/no-array-sort": "off"
      }
    },
    {
      "files": ["tools/agent-issue/omp-provider.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/no-continue": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/prefer-destructuring": "off",
        "eslint/sort-keys": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["tools/agent-issue/omp-runner.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/no-continue": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/sort-keys": "off",
        "typescript/method-signature-style": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["tools/agent-issue/run-metadata.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/sort-keys": "off",
        "import/exports-last": "off",
        "import/group-exports": "off",
        "unicorn/no-null": "off"
      }
    },
    {
      "files": ["tools/agent-issue/terminal-claim.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/init-declarations": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/sort-keys": "off",
        "import/group-exports": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["tools/agent-issue/agent-issue.test.ts"],
      "rules": {
        "eslint/func-style": "off",
        "eslint/max-lines-per-function": "off",
        "eslint/max-params": "off",
        "eslint/max-statements": "off",
        "eslint/no-await-in-loop": "off",
        "eslint/no-magic-numbers": "off",
        "eslint/no-ternary": "off",
        "eslint/require-unicode-regexp": "off",
        "eslint/sort-keys": "off",
        "typescript/array-type": "off",
        "typescript/method-signature-style": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/return-await": "off",
        "typescript/strict-boolean-expressions": "off",
        "unicorn/no-await-expression-member": "off",
        "unicorn/no-null": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "apps/server/integration/tests/fixtures/**"],
      "rules": {
        "eslint/max-lines": "off"
      }
    }
  ]
}

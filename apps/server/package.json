    "pg": "8.23.0",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@effect/vitest": "4.0.0-beta.100",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "fallow": "3.16.0",
    "vitest": "4.1.10"
  }

{
  "name": "@nama/server",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:fallow": "fallow audit --base HEAD --quiet",
    "check:fallow": "concurrently --kill-others-on-fail --names audit,security \"fallow --fail-on-issues\" \"fallow security --fail-on-issues\"",
    "check:auth-schema": "../../scripts/check-auth-schema.sh",
    "check:test": "../../scripts/check-server-tests.sh",
    "check:type": "tsc --project tsconfig.json --noEmit",
    "generate:auth-schema": "auth generate --config ./better-auth.config.ts --output ./src/database/auth-schema.ts --adapter drizzle --dialect postgresql --yes",
    "generate:migration": "pnpm run generate:auth-schema && drizzle-kit generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@effect/platform-node": "4.0.0-beta.100",
    "@nama/api": "workspace:*",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.100",
    "pg": "8.23.0",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.100",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "auth": "1.6.26",
    "drizzle-kit": "0.31.5",
    "fallow": "3.16.0",
    "vitest": "4.1.10"
  }
}
